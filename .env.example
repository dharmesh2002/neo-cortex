# Copy this to .env and fill in your values

# Anthropic API (required)
ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock (required for validation step)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Bedrock model for validation (cross-region inference profile or direct model ID)
# Example: us.anthropic.claude-sonnet-4-6-20250514-v1:0
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
